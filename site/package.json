{
  "name": "rigshelf-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:content": "bun scripts/prepare.ts",
    "dev": "bun run prepare:content && ASTRO_TELEMETRY_DISABLED=1 bun --bun astro dev --host 127.0.0.1",
    "build": "bun run prepare:content && ASTRO_TELEMETRY_DISABLED=1 bun --bun astro build",
    "check": "bun run prepare:content && ASTRO_TELEMETRY_DISABLED=1 bun --bun astro check",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 bun --bun astro preview --host 127.0.0.1",
    "format": "prettier --write \"src/**/*.astro\"",
    "lint": "prettier --check \"src/**/*.astro\""
  },
  "dependencies": {
    "astro": "7.4.7",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/three": "0.187.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "sharp": "0.35.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
