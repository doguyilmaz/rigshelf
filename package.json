{
  "name": "kitfold-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "kitfold": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run build && bun --watch src/cli.ts ui",
    "build": "vite build",
    "start": "bun src/cli.ts ui",
    "kitfold": "bun src/cli.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "verify": "bun run check && bun test && bun run build",
    "lint": "biome check src web tests scripts",
    "format": "biome check --write src web tests scripts",
    "test:ui": "bun scripts/ui-smoke.ts && bun scripts/ui-flows.ts && bun scripts/ui-stress.ts && bun scripts/ui-controls.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tar-stream": "^3.2.2",
    "yaml": "^2.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.5",
    "@playwright/test": "^1.64.1",
    "@types/bun": "1.4.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/tar-stream": "^3.1.5",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.4"
  }
}
