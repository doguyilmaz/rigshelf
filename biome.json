{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "src/**",
      "web/**",
      "tests/**",
      "scripts/**",
      "design/**/*.tsx",
      "*.json",
      "vite.config.ts",
      "!web/public",
      "site/src/**/*.ts",
      "site/src/**/*.css",
      "site/scripts/**/*.ts",
      "site/tests/**/*.ts",
      "site/*.json",
      "site/*.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noTemplateCurlyInString": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "off",
        "useImportType": "error"
      },
      "a11y": {
        "useButtonType": "error"
      }
    }
  }
}
